generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileStatus {
  DRAFT
  TESTED
  VERIFIED
}

enum ProfileSource {
  MANUAL
  MANUFACTURER
  COMMUNITY
  MIXED
}

enum FlavorNoteCategory {
  FRUIT
  BERRY
  CITRUS
  DESSERT
  DRINK
  SPICE
  FLORAL
  HERBAL
  COOLING
  NUT
  COFFEE
  CHOCOLATE
  DAIRY
  TROPICAL
  SMOKY
  OTHER
  // ADR-018: added to cover dominantNoteIds categories used in Product Flavor Profile Registry
  // that had no equivalent in the original 16-value enum. Additive only - nothing above renamed/removed.
  SOUR
  CANDY
  MINT
  TEA
  FRESH
  BAKERY
  ALCOHOL
  WOODY
  VANILLA
}

enum FlavorNoteType {
  DOMINANT
  SECONDARY
  ACCENT
}

enum CatalogIdentityStatus {
  RESOLVED
  MANUFACTURER_ONLY
  UNRESOLVED
  AMBIGUOUS
  INVALID
}

enum CatalogEntryType {
  REAL
  TEST
  INTERNAL
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flavors   Flavor[]
}

model Flavor {
  id                   Int                    @id @default(autoincrement())
  brandId              Int
  brand                Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String
  strength             Float?
  heatResistance       Float?
  intensity            Float?
  sweetness            Float?
  acidity              Float?
  cooling              Float?
  creaminess           Float?
  bitterness           Float?
  dryness              Float?
  juiciness            Float?
  freshness            Float?
  dessertLevel         Float?
  spiceLevel           Float?
  floralLevel          Float?
  herbalLevel          Float?
  smokyLevel           Float?
  naturalness          Float?
  persistence          Float?
  profileStatus        ProfileStatus
  profileSource        ProfileSource
  manufacturerId       String?
  productLineId        String?
  canonicalProductName String?
  canonicalProductId   String?                @unique
  identityStatus       CatalogIdentityStatus  @default(UNRESOLVED)
  identityVerified     Boolean                @default(false)
  catalogEntryType     CatalogEntryType       @default(REAL)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  notes                FlavorNoteAssignment[]
  mixComponents        MixComponent[]

  @@unique([brandId, slug])
}

model FlavorNote {
  id        Int                    @id @default(autoincrement())
  name      String
  slug      String                 @unique
  category  FlavorNoteCategory
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  flavors   FlavorNoteAssignment[]
}

model FlavorNoteAssignment {
  flavorId     Int
  flavorNoteId Int
  intensity    Int
  noteType     FlavorNoteType
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  flavor       Flavor         @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  flavorNote   FlavorNote     @relation(fields: [flavorNoteId], references: [id], onDelete: Cascade)

  @@id([flavorId, flavorNoteId])
}

model Mix {
  id                 Int            @id @default(autoincrement())
  title              String
  bowlType           String
  coalCount          Int
  warmupMinutes      Int
  compatibilityScore Float
  createdAt          DateTime       @default(now())
  components         MixComponent[]
}

model MixComponent {
  id         Int    @id @default(autoincrement())
  mixId      Int
  flavorId   Int
  percentage Int
  mix        Mix    @relation(fields: [mixId], references: [id], onDelete: Cascade)
  flavor     Flavor @relation(fields: [flavorId], references: [id])
}
